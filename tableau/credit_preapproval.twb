    <worksheet name='Trouble by PD'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Trouble rises with predicted risk
</run>
            <run fontcolor='#898989' fontsize='9'>Share who later had repayment trouble, by PD band · empty for the Test group</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PD bands' name='federated.0g6qfkt0s3k9od1h7o9wk0e11p6e' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Holdout (final exam, report only)' caption='Group' datatype='string' name='[Parameter 0193564081881089]' param-domain-type='list' role='measure' type='nominal' value='&quot;holdout&quot;'>
              <calculation class='tableau' formula='&quot;holdout&quot;' />
              <aliases>
                <alias key='&quot;fit&quot;' value='Fit (model learned here)' />
                <alias key='&quot;holdout&quot;' value='Holdout (final exam, report only)' />
                <alias key='&quot;test&quot;' value='Test (new applicants, outcome unknown)' />
                <alias key='&quot;valid&quot;' value='Valid (cut-off chosen here)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0g6qfkt0s3k9od1h7o9wk0e11p6e'>
            <column caption='In chosen group' datatype='boolean' name='[Calculation_0194000000000000101]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[split] = [Parameters].[Parameter 0193564081881089]' />
            </column>
            <column caption='Trouble rate' datatype='real' default-format='p0%' name='[Calculation_0194000000000000104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([defaults]) / SUM([known_outcome_clients])' />
            </column>
