# Copy this file to config/.env:
#   copy config\.env.example config\.env
# config/.env is ignored by git. It holds NO password.
#
# The HC password is kept in Windows Credential Manager and read by Python
# at connection time (docs/setup_wallet.md, section "Python").

ORACLE_USER=hc
ORACLE_DSN=localhost:1521/XEPDB1

# Name under which the password is stored in Windows Credential Manager
KEYRING_SERVICE=credit-preapproval-engine
